#!/usr/bin/env bash
# Org git hook (ADR-007): the client-side half of "deploy branches are PR-only".
#   * refuses any push that updates a deploy branch (org.toml branches.deploy; default main/master)
#   * before a push to the integration branch, runs the fast gate from org.toml when one is declared
# The server-side half is org-branch-guard.yml (detect-and-revert) and the release/deploy
# verification (approvals + check runs), so bypassing this hook gains nothing.
set -uo pipefail
[[ -n "${ORG_HOOKS_SKIP:-}" ]] && exit 0
here="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root="$(git rev-parse --show-toplevel)"
remote="$1"
# orgfile.py sits next to the hooks once distributed (.claude/hooks/org/) and one level
# further up in the source tree of the org repository (claude/orgfile.py).
orgfile="$here/../orgfile.py"; [[ -f "$orgfile" ]] || orgfile="$here/../../orgfile.py"
cfg() { [[ -f "$orgfile" ]] && python3 "$orgfile" "$root" "$1" 2>/dev/null; }
deploy_json="$(cfg branches.deploy)"; deploy_json="${deploy_json:-[\"main\",\"master\"]}"
integration="$(cfg branches.integration)"; integration="${integration:-staging}"
fast="$(cfg gate.fast || true)"
zero="0000000000000000000000000000000000000000"

is_deploy() { python3 - "$1" "$deploy_json" <<'EOF'
import json, sys
sys.exit(0 if sys.argv[1] in json.loads(sys.argv[2]) else 1)
EOF
}

rc=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [[ -z "${remote_ref:-}" ]] && continue
  branch="${remote_ref#refs/heads/}"
  [[ "$branch" == "$remote_ref" ]] && continue   # tags etc.
  if is_deploy "$branch"; then
    if [[ "$local_sha" == "$zero" ]]; then echo "pre-push: refusing to delete deploy branch '$branch'"; rc=1; continue; fi
    echo "pre-push: refusing direct push to deploy branch '$branch' — open a PR from '$integration' (skill org-branching)."
    echo "          A direct push would be reverted by the branch guard and never releases or deploys."
    rc=1; continue
  fi
  if [[ "$branch" == "$integration" && -n "$fast" && "$local_sha" != "$zero" ]]; then
    echo "pre-push: running the fast gate before pushing to '$integration': $fast"
    if ! (cd "$root" && bash -eo pipefail -c "$fast"); then
      echo "pre-push: fast gate failed; fix it or push with ORG_HOOKS_SKIP=1 if you are sure (CI will run it again)."
      rc=1
    fi
  fi
done
exit $rc
